{
  "name": "eco-geo-platform",
  "version": "1.0.0",
  "description": "ECO GEO 品牌 AI 监测平台 - Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create eco-geo-db",
    "db:migrate": "wrangler d1 execute eco-geo-db --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute eco-geo-db --local --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.114.0"
  }
}
